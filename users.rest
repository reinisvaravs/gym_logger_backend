@baseUrl = http://localhost:4000
@trainingTypeId = 1

### Register a user - expect 201; repeat to check 409
POST {{baseUrl}}/users/register
Origin: http://localhost:5173
Content-Type: application/json

{
  "firstName": "Test",
  "email": "test2@test.com",
  "password": "1234"
}

### Login a user
POST {{baseUrl}}/users/login
Origin: http://localhost:5173
Content-Type: application/json

{
  "email": "test2@test.com",
  "password": "1234"
}

### Me route
GET {{baseUrl}}/me

### Logout
POST {{baseUrl}}/users/logout
Origin: http://localhost:5173

### Change password
PATCH {{baseUrl}}/users/change-password
Origin: http://localhost:5173
Content-Type: application/json

{
  "currentPassword": "1234",
  "newPassword": "12345"
}

### Delete account
DELETE {{baseUrl}}/users/account
Origin: http://localhost:5173
Content-Type: application/json

{
  "currentPassword": "12345"
}

### Check trusted origin
POST {{baseUrl}}/users/login
Origin: http://localhost:5173
Content-Type: application/json

{}

### Get training types
GET {{baseUrl}}/training-types

### Create a training type
POST {{baseUrl}}/training-types
Origin: http://localhost:5173
Content-Type: application/json

{
  "trainingName": "Squat",
  "category": "weighted_reps"
}

### Rename an owned training type - set trainingTypeId to its actual ID
# Expect 200; missing or another user's ID returns 404; duplicate name returns 409.
PATCH {{baseUrl}}/training-types/{{trainingTypeId}}
Origin: http://localhost:5173
Content-Type: application/json

{
  "trainingName": "Barbell squat"
}

### Archive an owned training type
PATCH {{baseUrl}}/training-types/{{trainingTypeId}}/archive
Origin: http://localhost:5173

### Unarchive an owned training type
PATCH {{baseUrl}}/training-types/{{trainingTypeId}}/unarchive
Origin: http://localhost:5173

### Invalid training type ID
PATCH {{baseUrl}}/training-types/invalid/archive
Origin: http://localhost:5173
