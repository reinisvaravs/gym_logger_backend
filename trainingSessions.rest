@baseUrl = http://localhost:4000
@frontendOrigin = http://localhost:5173
# Your training type IDs
@weightedTypeId = 1
@bodyweightTypeId = 2
@cardioTypeId = 3
@sessionId = 1
@setId = 1

### Delete set
DELETE {{baseUrl}}/training-sessions/{{sessionId}}/sets/{{setId}}
Origin: {{frontendOrigin}}

### Delete invalid set
DELETE {{baseUrl}}/training-sessions/{{sessionId}}/sets/invalid
Origin: {{frontendOrigin}}

### Get my sessions
GET {{baseUrl}}/training-sessions

### Search sessions
GET {{baseUrl}}/training-sessions?search=squat

### Strength history
GET {{baseUrl}}/training-sessions?category=strength

### Filtered cardio history
GET {{baseUrl}}/training-sessions?category=cardio&search=run&from=2026-11-01&to=2026-11-30

### Invalid category
GET {{baseUrl}}/training-sessions?category=invalid

### Get month's sessions
GET {{baseUrl}}/training-sessions?from=2026-11-01&to=2026-11-30

### Get sessions from a date
GET {{baseUrl}}/training-sessions?from=2026-11-01

### Invalid date range
GET {{baseUrl}}/training-sessions?from=2026-11-30&to=2026-11-01

### Get session details
GET {{baseUrl}}/training-sessions/{{sessionId}}

### Add strength set
POST {{baseUrl}}/training-sessions/{{sessionId}}/sets
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "reps": 8,
  "weightKg": 50
}

### Invalid set
POST {{baseUrl}}/training-sessions/{{sessionId}}/sets
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "reps": -1,
  "weightKg": 50
}

### Edit set
PATCH {{baseUrl}}/training-sessions/{{sessionId}}/sets/{{setId}}
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "reps": 10,
  "weightKg": 55
}

### Invalid reps update
PATCH {{baseUrl}}/training-sessions/{{sessionId}}/sets/{{setId}}
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "reps": null
}

### Invalid session ID
GET {{baseUrl}}/training-sessions/invalid

### Delete session
DELETE {{baseUrl}}/training-sessions/{{sessionId}}
Origin: {{frontendOrigin}}

### Delete invalid session
DELETE {{baseUrl}}/training-sessions/invalid
Origin: {{frontendOrigin}}

### Edit session notes
PATCH {{baseUrl}}/training-sessions/{{sessionId}}
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "notes": "Updated session notes"
}

### Move session
PATCH {{baseUrl}}/training-sessions/{{sessionId}}
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "performedOn": "2026-11-10",
  "sessionOrder": 1
}

### Clear notes
PATCH {{baseUrl}}/training-sessions/{{sessionId}}
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "notes": null
}

### Create strength session
POST {{baseUrl}}/training-sessions
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "trainingTypeId": "{{weightedTypeId}}",
  "performedOn": "2026-11-09",
  "sessionOrder": 1,
  "notes": "Squat practice",
  "sets": [
    { "reps": 8, "weightKg": 40 },
    { "reps": 6, "weightKg": 45 }
  ]
}

### Create bodyweight session
POST {{baseUrl}}/training-sessions
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "trainingTypeId": "{{bodyweightTypeId}}",
  "performedOn": "2026-11-09",
  "sessionOrder": 2,
  "sets": [ { "reps": 10 } ]
}

### Create cardio session
POST {{baseUrl}}/training-sessions
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "trainingTypeId": "{{cardioTypeId}}",
  "performedOn": "2026-11-09",
  "sessionOrder": 3,
  "sets": [
    {
      "durationSeconds": 1800,
      "distanceKm": 5,
      "avgHeartRateBpm": 145,
      "elevationGainM": 20
    }
  ]
}

### Invalid date
POST {{baseUrl}}/training-sessions
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "trainingTypeId": "{{weightedTypeId}}",
  "performedOn": "2026-02-30",
  "sessionOrder": 4,
  "sets": [ { "reps": 8, "weightKg": 40 } ]
}

### Invalid strength measurements
POST {{baseUrl}}/training-sessions
Origin: {{frontendOrigin}}
Content-Type: application/json

{
  "trainingTypeId": "{{weightedTypeId}}",
  "performedOn": "2026-11-09",
  "sessionOrder": 4,
  "sets": [ { "durationSeconds": 600, "distanceKm": 1 } ]
}

